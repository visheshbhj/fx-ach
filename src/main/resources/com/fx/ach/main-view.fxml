<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.fx.ach.MainController" fx:id="root">
    <top>
        <VBox>
            <MenuBar>
                <Menu text="_File">
                    <Menu fx:id="newMenu" text="_New from template"/>
                    <MenuItem text="_Open…" onAction="#onOpen">
                        <accelerator><KeyCodeCombination code="O" control="UP" shift="UP" alt="UP" meta="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <SeparatorMenuItem/>
                    <MenuItem text="_Save" onAction="#onSave">
                        <accelerator><KeyCodeCombination code="S" control="UP" shift="UP" alt="UP" meta="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <MenuItem text="Save _As…" onAction="#onSaveAs">
                        <accelerator><KeyCodeCombination code="S" control="UP" shift="DOWN" alt="UP" meta="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <MenuItem text="Save as _Template…" onAction="#onSaveTemplate"/>
                    <MenuItem text="_Export Readable Report (HTML)…" onAction="#onExportReport"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="E_xit" onAction="#onExit"/>
                </Menu>
                <Menu text="_Edit">
                    <MenuItem text="_Undo" onAction="#onUndo">
                        <accelerator><KeyCodeCombination code="Z" control="UP" shift="UP" alt="UP" meta="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <SeparatorMenuItem/>
                    <MenuItem text="Add _Batch…" onAction="#onAddBatch"/>
                    <MenuItem text="Add _Entry…" onAction="#onAddEntry">
                        <accelerator><KeyCodeCombination code="E" control="UP" shift="UP" alt="UP" meta="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <MenuItem text="Add A_ddenda…" onAction="#onAddAddenda"/>
                    <MenuItem text="_Delete Selected" onAction="#onDelete"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="_Recalculate Totals &amp; Controls" onAction="#onRecalculate">
                        <accelerator><KeyCodeCombination code="R" control="UP" shift="UP" alt="UP" meta="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <MenuItem text="Renumber _Trace Numbers" onAction="#onRenumber"/>
                </Menu>
            </MenuBar>
            <ToolBar>
                <MenuButton fx:id="newButton" text="New"/>
                <Button text="Open" onAction="#onOpen"/>
                <Button text="Save" onAction="#onSave"/>
                <Separator/>
                <Button text="+ Batch" onAction="#onAddBatch"/>
                <Button text="+ Entry" onAction="#onAddEntry"/>
                <Button text="Delete" onAction="#onDelete"/>
                <Separator/>
                <Button text="Fix Totals" onAction="#onRecalculate">
                    <tooltip><Tooltip text="Recompute batch and file control records (counts, hashes, totals)"/></tooltip>
                </Button>
                <Button text="Report" onAction="#onExportReport"/>
                <Separator/>
                <ToggleButton fx:id="notRawToggle" text="Not raw mode">
                    <tooltip><Tooltip text="Show the file as collapsible forms instead of raw 94-character lines"/></tooltip>
                </ToggleButton>
                <ToggleButton fx:id="editModeToggle" text="Edit mode">
                    <tooltip><Tooltip text="Apply field changes automatically when moving to another record, without asking"/></tooltip>
                </ToggleButton>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusBadge" styleClass="badge"/>
            </ToolBar>
        </VBox>
    </top>
    <center>
        <SplitPane fx:id="mainSplit" dividerPositions="0.66">
            <SplitPane orientation="VERTICAL" dividerPositions="0.8">
                <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE">
                    <Tab fx:id="fileTab" text="File">
                        <StackPane fx:id="fileStack">
                            <VBox fx:id="rawPane">
                                <Label fx:id="ruler" styleClass="ruler"/>
                                <ListView fx:id="rawList" styleClass="raw-list" VBox.vgrow="ALWAYS"/>
                            </VBox>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="summaryTab" text="Summary">
                        <ScrollPane fx:id="overviewScroll" fitToWidth="true"/>
                    </Tab>
                </TabPane>
                <VBox>
                    <Label fx:id="issuesTitle" text="VALIDATION" styleClass="pane-title"/>
                    <ListView fx:id="issuesList" VBox.vgrow="ALWAYS"/>
                </VBox>
            </SplitPane>
        </SplitPane>
    </center>
    <bottom>
        <HBox styleClass="status-bar">
            <padding><Insets top="3" right="10" bottom="3" left="10"/></padding>
            <Label fx:id="statusLabel" text="Open an ACH file or start a new one from a template. Right-click a record to insert before/after it."/>
        </HBox>
    </bottom>
</BorderPane>
